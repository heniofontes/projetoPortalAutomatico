# Selecionar empresa
def selecionar_empresa_combo(driver, codigo, combo_numero):
    try:
        dropdowns = driver.find_elements(By.CSS_SELECTOR, ".choices__inner")
        dropdown = dropdowns[combo_numero - 1]
        dropdown.click()
        time.sleep(1)

        opcao = driver.find_element(By.XPATH, f"//div[contains(text(), '{codigo}')]")
        driver.execute_script("arguments[0].click();", opcao)
        print(f"✅ Empresa {codigo} selecionada (combo {combo_numero})")
        time.sleep(1)
        return True
    except Exception as e:
        print(f"❌ Erro: {e}")
        return False


# Preencher movimento
def preencher_movimento(driver, movimento):
    try:
        campo = driver.find_element(By.XPATH, "//input[@placeholder='Digite o Nome do Beneficiário ou Nº Movimento']")
        campo.clear()
        campo.send_keys(movimento)
        print(f"✅ Movimento {movimento} - preenchido")
        time.sleep(1)
        campo.send_keys(Keys.ENTER)
        print(f"✅ Enter pressionado")
        time.sleep(2)
        return True
    except Exception as e:
        print(f"❌ Erro ao preencher movimento: {e}")
        return False


