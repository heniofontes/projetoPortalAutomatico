# Buscar arquivos na pasta
def buscar_arquivos_por_movimento(pasta, numero_movimento):
    arquivos_encontrados = []
    numero_movimento_str = str(numero_movimento)

    for arquivo in Path(pasta).iterdir():
        if arquivo.is_file() and arquivo.suffix.lower() == '.pdf':
            nome_arquivo = arquivo.stem
            if nome_arquivo.startswith(numero_movimento_str):
                arquivos_encontrados.append(arquivo)
                print(f"  📄 Encontrado: {arquivo.name}")

    return arquivos_encontrados


# Fazer upload automático
def fazer_upload_auto(driver, caminho_arquivo):
    try:
        # Clica no botão "Selecionar"
        botao_selecionar = WebDriverWait(driver, 10).until(
            EC.element_to_be_clickable((By.XPATH, "//span[contains(text(), 'Selecionar')]"))
        )
        driver.execute_script("arguments[0].click();", botao_selecionar)
        print(f"  ✅ Botão 'Selecionar' clicado")
        time.sleep(2)

        # Copia o caminho do arquivo para a área de transferência
        caminho_completo = str(caminho_arquivo)
        pyperclip.copy(caminho_completo)
        print(f"  ✅ Caminho copiado: {caminho_arquivo.name}")
        time.sleep(1)

        # Cola o caminho (Ctrl+V)
        pyautogui.hotkey('ctrl', 'v')
        print(f"  ✅ Caminho colado")
        time.sleep(1)

        # Pressiona Enter para confirmar
        pyautogui.press('enter')
        print(f"  ✅ Enter pressionado - arquivo selecionado")
        time.sleep(3)

        # Voltar o foco para o navegador
        driver.find_element(By.TAG_NAME, 'body').click()
        time.sleep(1)

        # Clicar no botão "Adicionar"
        botao_adicionar = driver.find_element(By.XPATH, "//button[.//span[contains(text(), 'Adicionar')]]")
        driver.execute_script("arguments[0].click();", botao_adicionar)
        print(f"  ✅ Botão 'Adicionar' clicado - arquivo anexado")
        time.sleep(2)
        return True

    except Exception as e:
        print(f"  ❌ Erro no upload automático: {e}")
        return False


# VOLTAR PARA A TELA DE LISTA
def voltar_para_lista(driver):
    try:
        botao_voltar = driver.find_element(By.XPATH, "//button[contains(text(), 'Voltar')]")
        driver.execute_script("arguments[0].click();", botao_voltar)
        print("✅ Botão 'Voltar' clicado")
        time.sleep(2)
        return True
    except:
        try:
            botao_cancelar = driver.find_element(By.XPATH, "//button[contains(text(), 'Cancelar')]")
            driver.execute_script("arguments[0].click();", botao_cancelar)
            print("✅ Botão 'Cancelar' clicado")
            time.sleep(2)
            return True
        except:
            driver.back()
            print("✅ Voltando via navegador")
            time.sleep(2)
            return True


