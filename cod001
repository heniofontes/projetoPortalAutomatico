pasta_chico = r"C:\chico"
caminho_planilha = r"C:\chico\robo-chico.xlsx"

planilha = openpyxl.load_workbook(caminho_planilha)
aba = planilha.active

# Mostrar todas as linhas que serão processadas
print(f"\n📋 PLANILHA ENCONTRADA:")
print(f"   Total de linhas: {aba.max_row - 1}")
for linha_tmp in range(2, aba.max_row + 1):
    codigo_tmp = str(aba.cell(row=linha_tmp, column=1).value)
    movimento_tmp = aba.cell(row=linha_tmp, column=3).value
    print(f"   Linha {linha_tmp - 1}: Código={codigo_tmp} | Movimento={movimento_tmp}")

print(f"\n{'=' * 60}")
print(f"Iniciando processamento na ordem da planilha...")
print(f"{'=' * 60}\n")

# Loop para cada linha da planilha (já está em ordem)
for linha in range(2, aba.max_row + 1):
    codigo = str(aba.cell(row=linha, column=1).value)
    movimento = aba.cell(row=linha, column=3).value
    nome = aba.cell(row=linha, column=2).value  # Coluna B

    print(f"\n{'=' * 60}")
    print(f"📌 PROCESSANDO LINHA {linha - 1} DA PLANILHA")
    print(f"   Código Empresa: {codigo}")
    print(f"   Nome: {nome}")
    print(f"   Movimento: {movimento}")
    print(f"{'=' * 60}")

    # Preencher movimento
    preencher_movimento(driver, movimento)

    # Clicar editar
    clicar_botao_editar(driver)

    # Buscar arquivos na pasta
    arquivos = buscar_arquivos_por_movimento(pasta_chico, movimento)
    print(f"\n📁 Encontrados {len(arquivos)} arquivo(s) para o movimento {movimento}")

    if len(arquivos) == 0:
        print(f"⚠️ Nenhum arquivo encontrado, indo para próximo movimento...")
        voltar_para_lista(driver)
        continue

    # Upload de cada arquivo
    for i, arquivo in enumerate(arquivos):
        print(f"\n📤 Enviando arquivo {i + 1}/{len(arquivos)}: {arquivo.name}")
        fazer_upload_auto(driver, arquivo)
        time.sleep(2)

    # Voltar para a lista para processar o próximo movimento
    print(f"\n🔙 Movimento {movimento} finalizado. Voltando para lista...")
    voltar_para_lista(driver)

    print(f"✅ Linha {linha - 1} concluída!")

print("\n" + "=" * 60)
print("✅ PROCESSAMENTO CONCLUÍDO! Todas as linhas da planilha foram processadas em ordem.")
print("=" * 60)

input("Pressione Enter para fechar...")
driver.quit()
